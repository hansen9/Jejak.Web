@{
    Layout = "_SFDLayout";
}
<style>
    .dashboard-app { min-height: 100dvh; }
    .sidebar-bottom { margin-top: auto; padding-top: 50px; }
    .dashboard-main { max-width: 1700px; margin: auto; padding: 29px 35px 0; }
    .page-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 25px; }
    .page-heading h1 { font-size: 29px; line-height: 1.25; font-weight: 750; letter-spacing: -1.05px; color: #382c41; }
    .page-heading p { font-size: 11.5px; line-height: 1.8; color: var(--subtle); margin-top: 7px; }
    .demo-tag { display: inline-block; background: var(--copper-light); border-radius: 3px; color: #a17d62; font-size: 9px; padding: 0 5px; line-height: 18px; margin-left: 5px; vertical-align: 1px; }
    .heading-actions { display: flex; align-items: center; gap: 10px; padding-top: 17px; flex-shrink: 0; }
    .refresh-button { margin-right: 1px; }
    .date-filter { display: flex; align-items: center; gap: 9px; border: 1px solid #e5e0ea; background: var(--paper); border-radius: 7px; min-height: 37px; padding: 8px 11px; color: #756880; font-size: 10px; }
    .date-filter input { border: none; outline: none; background: transparent; color: #615268; width: 116px; font-size: 10px; font-weight: 600; }
    .date-filter input:focus { outline: none; }
    .date-filter input::-webkit-calendar-picker-indicator { opacity: .55; width: 13px; cursor: pointer; }
    .date-filter>svg:last-child { display: none; }
    .metrics { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; margin-bottom: 23px; }
    .metric { padding: 17px 20px 16px; background: var(--paper); border-radius: 10px; }
    .metric-remaining { background: #f3edef; }
    .metric-label { display: flex; align-items: center; justify-content: space-between; gap: 7px; color: #7b7184; font-size: 11px; font-weight: 550; }
    .metric-icon { display: flex; align-items: center; justify-content: center; width: 31px; height: 31px; border-radius: 7px; background: #f6f2f8; color: #977d9f; }
    .metric-remaining .metric-icon { background: #ede2e6; color: #ad8890; }
    .metric-value { font-size: 34px; font-weight: 750; letter-spacing: -1.5px; line-height: 1.25; margin-top: 5px; color: #46344f; }
    .metric-value>span { font-size: 15px; color: #9c8ba4; font-weight: 450; letter-spacing: -.3px; margin-left: 6px; }
    .metric-active .metric-value>span { font-size: 19px; }
    .metric-foot { display: flex; align-items: center; flex-wrap: wrap; column-gap: 5px; row-gap: 3px; margin-top: 9px; color: #7d7483; font-size: 8.5px; min-height: 14px; }
    .metric-foot>svg { color: var(--green); }
    .metric-foot i { width: 2px; height: 2px; background: #b3a7b8; border-radius: 50%; margin: 0 1px; }
    .metric-detail { color: #a094a8; font-size: 8px; }
    .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 19px 21px 0; }
    .panel-heading h2 { font-size: 13px; font-weight: 750; letter-spacing: -.15px; color: #4b3c56; }
    .panel-heading p { font-size: 9px; color: #a195a9; margin-top: 5px; line-height: 1.6; }
    .map-panel { margin-bottom: 22px; }
    .map-panel-heading { padding: 15px 21px 12px; }
    .map-title { display: flex; align-items: center; gap: 10px; }
    .live-badge { display: flex; align-items: center; gap: 4px; background: #f0f5f1; color: #7e9986; font-size: 7px; font-weight: 700; border-radius: 4px; padding: 3px 5px; letter-spacing: .5px; }
    .map-panel-actions { display: flex; align-items: center; gap: 11px; }
    .last-update { font-size: 9px; color: #aa9eb1; }
    .map-toolbar { border-top: 1px solid #f1edf4; padding: 10px 21px; display: flex; align-items: center; justify-content: space-between; gap: 15px; }
    .map-toolbar p { display: flex; align-items: center; gap: 6px; color: #7d7386; font-size: 9px; }
    .map-toolbar p>span:last-child { color: #aba0b3; }
    .toolbar-separator { margin: 0 3px; }
    .map-layer-options { display: flex; align-items: center; gap: 16px; }
    .map-layer-options label { display: flex; align-items: center; gap: 5px; font-size: 9px; color: #8b7f95; cursor: pointer; }
    .map-layer-options input { accent-color: var(--plum); width: 11px; height: 11px; margin: 0; border-radius: 3px; cursor: pointer; }
    .map-and-team { display: grid; grid-template-columns: minmax(0,1fr) 286px; }
    .map-canvas { position: relative; min-width: 0; height: 423px; background: #e9eae5; overflow: hidden; }
    .leaflet-container-slot { height: 100%; width: 100%; background: #ebece7; z-index: 0; }
    .leaflet-container { font-family: var(--font-body); }
    .leaflet-control-attribution { font-size: 7px !important; color: #999 !important; background: rgba(255,255,255,.85) !important; padding: 1px 4px !important; }
    .leaflet-control-attribution a { color: #858087 !important; }
    .map-location { position: absolute; top: 17px; left: 17px; background: rgba(255,255,255,.94); padding: 9px 11px; border: 1px solid white; border-radius: 6px; display: flex; align-items: center; gap: 6px; pointer-events: none; font-size: 9px; box-shadow: 0 2px 8px #716c7910; z-index: 5; }
    .map-location strong { font-weight: 650; }
    .map-location>span:last-child { font-size: 8px; color: #a99cab; border-left: 1px solid var(--line); padding-left: 7px; margin-left: 2px; }
    .map-controls { position: absolute; top: 17px; right: 16px; display: flex; flex-direction: column; padding: 4px; background: rgba(255,255,255,.95); border-radius: 6px; box-shadow: 0 2px 8px #716c7915; z-index: 5; }
    .map-controls button { width: 29px; height: 31px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; color: #7d7386; border-radius: 4px; }
    .map-controls button:hover { background: var(--plum-light); color: var(--plum); }
    .map-controls>span { height: 1px; width: 21px; margin: 3px auto; background: var(--line); }
    .map-style { position: absolute; bottom: 48px; left: 17px; display: flex; align-items: center; gap: 7px; padding: 9px 11px; font-size: 9px; color: #86798f; border: 2px solid white; background: #fefdfef2; border-radius: 5px; z-index: 5; box-shadow: 0 2px 8px #716c7910; }
    .map-style:hover { background: var(--plum-light); }
    .map-legend { position: absolute; bottom: 17px; left: 17px; border-radius: 4px; background: #ffffffed; padding: 7px 10px; display: flex; align-items: center; gap: 16px; z-index: 5; font-size: 8px; color: #8c8095; pointer-events: none; }
    .map-legend>span { display: flex; align-items: center; gap: 6px; }
    .legend-line { width: 15px; border-top: 2px solid var(--plum); }
    .legend-dashed { width: 15px; border-top: 2px dashed var(--copper); }
    .legend-dot { width: 6px; height: 6px; border-radius: 50%; border: 1px solid white; background: var(--plum); outline: 1px solid #cbb5d2; }
    .map-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: #ebece7; color: #a29aaa; font-size: 12px; }
    .team-map-marker { position: relative; transition: opacity .18s; }
    .marker-face { display: flex; width: 32px; height: 32px; border: 3px solid white; color: white; font-size: 9px; font-weight: 750; align-items: center; justify-content: center; border-radius: 50%; box-shadow: 0 2px 6px #50445345; margin: 3px; }
    .marker-arrow { width: 0; height: 0; border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 9px solid var(--plum); position: absolute; top: -6px; left: 15px; transform-origin: 4px 25px; }
    .marker-status { width: 7px; height: 7px; border: 1.5px solid white; border-radius: 50%; background: var(--green); position: absolute; bottom: 2px; right: 3px; }
    .marker-status.berhenti { background: var(--copper); }
    .marker-status.offline { background: #a69ca9; }
    .team-map-marker.selected .marker-face { outline: 5px solid #bda2c660; }
    .team-tooltip { font: 10px var(--font-body); border: 0; border-radius: 5px; padding: 7px 9px; box-shadow: 0 2px 9px #48364f20; color: var(--plum-dark); }
    .map-fullscreen { position: fixed; z-index: 60; inset: 15px; width: calc(100vw - 30px); height: calc(100dvh - 30px) !important; border-radius: 12px; box-shadow: 0 0 0 20px #302a3899; }
    .map-error { position: absolute; z-index: 5; bottom: 56px; right: 15px; font-size: 8px; background: var(--copper-light); padding: 8px; border-radius: 4px; color: var(--copper); max-width: 220px; }
    .map-empty { position: absolute; top: 45%; left: 50%; transform: translateX(-50%); background: #ffffffec; color: var(--subtle); padding: 12px; border-radius: 6px; z-index: 5; font-size: 11px; white-space: nowrap; }
    .team-live { display: flex; flex-direction: column; height: 423px; border-left: 1px solid var(--line); min-width: 0; }
    .team-live-heading { display: flex; align-items: center; justify-content: space-between; padding: 15px 16px 10px; }
    .team-live-heading h3 { font-size: 11px; font-weight: 700; color: #67566f; display: flex; align-items: center; gap: 6px; }
    .team-live-heading h3>span { font-size: 8px; padding: 1px 5px; color: #a694ad; background: #f5f1f8; border-radius: 3px; }
    .status-filter { position: relative; cursor: pointer; color: #a295ac; }
    .status-filter select { position: absolute; inset: -8px; width: 32px; opacity: 0; cursor: pointer; }
    .team-search { display: flex; align-items: center; margin: 0 16px 8px; padding: 8px 9px; gap: 6px; background: #faf8fc; color: #b0a4b9; border: 1px solid #f0eaf5; border-radius: 5px; }
    .team-search input { background: transparent; outline: none; border: none; width: 100%; font-size: 9px; }
    .team-search input:focus { outline: none; }
    .team-live-list { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #ded4e5 transparent; }
    .live-member { display: flex; width: 100%; align-items: center; gap: 8px; padding: 10px 16px; border: none; background: transparent; text-align: left; }
    .live-member:hover { background: #f9f6fb; }
    .live-member.selected { background: var(--plum-light); }
    .member-avatar { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 31px; height: 31px; flex-shrink: 0; border-radius: 50%; background: color-mix(in srgb, var(--member-color) 15%, white); color: var(--member-color); font-size: 9px; font-weight: 750; border: 1px solid color-mix(in srgb, var(--member-color) 17%, white); }
    .avatar-status { position: absolute; width: 6px; height: 6px; bottom: -1px; right: 1px; background: var(--green); border: 1.4px solid white; border-radius: 50%; }
    .avatar-status.berhenti { background: var(--copper); }
    .avatar-status.offline { background: #ac9bb4; }
    .live-member-info { flex: 1; min-width: 0; }
    .live-member-info strong { display: block; font-size: 9px; font-weight: 650; color: #5c4b66; white-space: nowrap; }
    .live-member-info small { display: block; font-size: 8px; color: #ad9fb6; margin-top: 4px; }
    .live-member-speed { display: flex; flex-direction: column; text-align: right; flex-shrink: 0; align-items: flex-end; gap: 4px; }
    .live-member-speed>strong { font-size: 11px; font-weight: 750; color: #62506c; display: flex; align-items: baseline; gap: 3px; }
    .live-member-speed>strong>small { font-size: 7px; color: #b0a1b8; font-weight: 450; }
    .member-state { display: flex; align-items: center; gap: 3px; font-size: 7px; color: #9c8ba8; }
    .member-state.berhenti { color: var(--copper); }
    .member-state.offline { color: #b0a5b7; }
    .team-all { display: flex; align-items: center; justify-content: center; gap: 7px; border: none; border-top: 1px solid var(--line); background: white; color: var(--plum); padding: 13px 5px; font-size: 9px; font-weight: 600; }
    .team-all:hover { background: var(--plum-light); }
    .selected-distance { font-size: 9px; padding: 10px 14px; color: var(--subtle); background: #faf7fc; display: flex; justify-content: space-between; }
    .selected-distance strong { color: var(--plum); }
    .selected-member-detail { background: #faf7fc; border-top: 1px solid var(--line); }
    .selected-member-detail .selected-distance { padding-top: 7px; padding-bottom: 4px; font-size: 8px; }
    .selected-coordinates { padding: 4px 14px 8px; font-size: 7px; color: #9d87a7; }
    .list-empty { font-size: 10px; text-align: center; color: var(--subtle); padding: 45px 20px; line-height: 1.8; }
    .expanded .map-canvas, .expanded .team-live { height: 590px; }
    .expanded .live-member { padding-top: 17px; padding-bottom: 17px; }
    .charts-grid { display: grid; grid-template-columns: 1.07fr .91fr 1.05fr; gap: 18px; margin-bottom: 22px; }
    .charts-grid>.panel { min-width: 0; min-height: 255px; }
    .charts-grid .panel-heading { padding: 17px 18px 0; }
    .charts-grid .panel-heading h2 { font-size: 11.5px; }
    .charts-grid .panel-heading p { font-size: 8px; margin-top: 4px; }
    .bar-chart { padding: 17px 18px 15px; }
    .bar-row { display: flex; align-items: center; gap: 10px; height: 24px; }
    .bar-name { font-size: 8px; color: #9a8ca4; width: 48px; flex-shrink: 0; }
    .bar-name small { font-size: 8px; }
    .bar-track { flex: 1; height: 8px; border-radius: 2px; background: repeating-linear-gradient(to right, transparent 0%, transparent calc(33.33% - 1px), #f2edf6 calc(33.33% - 1px), #f2edf6 33.33%); }
    .bar-fill { height: 8px; border-radius: 0 2px 2px 0; opacity: .83; }
    .bar-row>strong { font-size: 8px; font-weight: 650; color: #7a668a; flex-shrink: 0; width: 37px; text-align: right; }
    .bar-row>strong>span { font-size: 7px; color: #af9cba; font-weight: 450; }
    .bar-axis { display: flex; align-items: center; justify-content: space-between; padding: 8px 46px 0 58px; color: #b2a5bc; font-size: 7px; }
    .donut-content { display: flex; align-items: center; justify-content: center; gap: 20px; padding: 10px 17px 0; }
    .donut { position: relative; width: 144px; flex-shrink: 0; }
    .donut svg { width: 100%; display: block; }
    .donut-label { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .donut-label strong { font-size: 28px; font-weight: 750; letter-spacing: -1px; color: #634671; }
    .donut-label strong>span { font-size: 15px; margin-left: 2px; }
    .donut-label small { font-size: 7.5px; color: #ac96b8; margin-top: 1px; }
    .coverage-key { display: flex; flex-direction: column; gap: 18px; }
    .coverage-key>div>span { display: flex; align-items: center; gap: 5px; color: #a08aac; font-size: 7.5px; white-space: nowrap; }
    .key-dot { display: inline-block; width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }
    .key-dot.plum { background: var(--plum); }
    .key-dot.blush { background: var(--blush); }
    .coverage-key strong { display: block; font-size: 13px; margin: 5px 0 0 10px; font-weight: 700; color: #70577e; }
    .coverage-key strong>small { color: #b49fc0; font-size: 8px; font-weight: 450; }
    .coverage-total { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #f2edf6; margin: 4px 18px 0; padding: 10px 0; font-size: 7.5px; color: #b2a0be; }
    .coverage-total strong { font-size: 8px; color: #957ca4; font-weight: 600; }
    .chart-select { display: flex; align-items: center; gap: 4px; border: 1px solid #ece3f2; padding: 5px 7px; border-radius: 4px; color: #a088b0; }
    .chart-select select { border: none; background: transparent; outline: none; appearance: none; font-size: 8px; padding: 0; width: 38px; }
    .chart-select select:focus { outline: none; }
    .activity-plot { position: relative; padding: 13px 16px 4px; }
    .plot-key { display: flex; align-items: center; gap: 5px; font-size: 7px; color: #aa95b5; margin: 0 0 5px 15px; }
    .activity-plot>svg { width: 100%; display: block; }
    .activity-plot text { font: 8px var(--font-body); fill: #b1a0ba; }
    .chart-tooltip { position: absolute; top: 40px; left: 65px; padding: 7px 9px; border: 1px solid var(--line); background: white; border-radius: 5px; font-size: 8px; color: var(--subtle); pointer-events: none; }
    .chart-tooltip strong { color: var(--plum); }
    .chart-empty { height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; font-size: 10px; color: #ab9ab6; }
    .member-table-panel { margin-bottom: 22px; }
    .member-table-panel .panel-heading { padding-bottom: 16px; }
    .table-scroll { overflow-x: auto; scrollbar-width: thin; }
    .member-table { border-collapse: collapse; width: 100%; text-align: left; white-space: nowrap; }
    .member-table thead { background: #faf8fc; border-bottom: 1px solid #f0eaf5; }
    .member-table th { font-size: 8px; font-weight: 550; color: #a38faf; padding: 11px 17px; }
    .member-table th:first-child { padding-left: 22px; }
    .member-table th button { border: none; background: transparent; color: inherit; display: inline-flex; align-items: center; gap: 7px; padding: 0; font-size: 8px; }
    .member-table td { font-size: 9px; color: #9981a9; padding: 11px 17px; border-bottom: 1px solid #f4eff7; }
    .member-table tr:last-child td { border-bottom: none; }
    .member-table tr:hover td { background: #fcfafd; }
    .member-table td:first-child { padding-left: 22px; }
    .member-table td:last-child { padding-right: 16px; padding-left: 4px; }
    .member-table td>strong { font-weight: 650; color: #705580; }
    .table-person { display: flex; align-items: center; gap: 9px; }
    .member-avatar.small { width: 29px; height: 29px; font-size: 8px; }
    .table-person strong { display: block; color: #6d537c; font-size: 9px; font-weight: 650; }
    .table-person small { display: block; font-size: 7px; color: #b7a3c2; margin-top: 4px; }
    .table-unit { font-size: 7px; color: #baa4c7; }
    .table-direction { display: flex; align-items: center; gap: 5px; font-size: 8px; color: #a289b1; }
    .battery { display: flex; align-items: center; gap: 5px; font-size: 8px; color: #85968b; }
    .battery.low { color: #b58b78; }
    .table-footer-button { width: 100%; background: white; display: flex; align-items: center; justify-content: center; gap: 7px; padding: 12px; border: none; border-top: 1px solid #f2edf6; font-size: 8px; color: #9980a7; }
    .table-footer-button:hover { background: var(--plum-light); }
    .table-empty { padding: 50px 20px; display: flex; flex-direction: column; align-items: center; gap: 10px; color: #a28aaf; }
    .table-empty h3 { font-size: 13px; color: #775485; }
    .table-empty p { font-size: 11px; margin-bottom: 9px; }
    .routes-panel { margin-bottom: 22px; }
    .routes-panel .panel-heading { padding-bottom: 19px; }
    .route-name { display: flex; align-items: center; gap: 12px; }
    .route-name>svg { color: #b096bd; }
    .route-name strong { display: block; color: #755382; font-size: 10px; }
    .route-name small { display: block; font-size: 8px; margin-top: 5px; color: #b59ec0; }
    .route-progress { display: flex; align-items: center; gap: 12px; width: 150px; }
    .route-progress>div { height: 5px; background: var(--donut-rest); border-radius: 3px; flex: 1; }
    .route-progress>div>span { height: 100%; display: block; background: var(--plum); border-radius: 3px; }
    .route-progress>strong { font-size: 9px; width: 30px; font-weight: 600; }
    .text-copper { color: var(--copper) !important; }
    .route-note { padding: 15px 21px; border-top: 1px solid #f4eef7; color: #a18cad; font-size: 9px; line-height: 1.7; }
    .report-panel { display: flex; gap: 35px; padding: 43px; margin-bottom: 22px; }
    .report-icon { color: var(--plum); background: var(--plum-light); padding: 22px; height: fit-content; border-radius: 13px; }
    .report-content { max-width: 630px; }
    .report-content h2 { font-size: 24px; font-weight: 750; letter-spacing: -.7px; margin-bottom: 13px; color: #664570; }
    .report-content>p { font-size: 11px; line-height: 1.9; color: #a48db0; }
    .report-facts { display: flex; gap: 25px; margin: 25px 0; color: #a48db0; font-size: 10px; }
    .report-facts strong { font-size: 16px; color: #705079; margin-right: 3px; }
    .report-buttons { display: flex; align-items: center; gap: 10px; }
    .report-disclaimer { display: flex; align-items: center; gap: 6px; font-size: 8px !important; margin-top: 20px; }
    .demo-banner { display: flex; align-items: center; gap: 12px; padding: 15px 19px; background: #ede8f1; border-radius: 8px; margin: 0 0 23px; }
    .demo-banner-icon { display: flex; align-items: center; justify-content: center; color: #9d80ad; border-radius: 7px; width: 34px; height: 34px; background: #f6f2f8; }
    .demo-banner>div { flex: 1; }
    .demo-banner strong { font-size: 10px; color: #80648f; font-weight: 650; }
    .demo-banner p { font-size: 8.5px; color: #a28aad; margin-top: 4px; }
    .demo-banner>button:not(.icon-button) { border: none; border-radius: 5px; display: flex; align-items: center; gap: 5px; padding: 8px 11px; color: #8a6a9b; background: #fcfafd; font-size: 8px; font-weight: 650; }
    .demo-banner>button:not(.icon-button):hover { background: white; }
    .demo-banner>.icon-button { margin-left: -3px; color: #a994b4; }
    .dashboard-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 0 22px; color: #b4a6bf; font-size: 8px; }
    .dashboard-footer>div { display: flex; align-items: center; gap: 5px; }
    .dashboard-footer>div>i { width: 2px; height: 2px; background: #c6b7d0; border-radius: 50%; margin: 0 5px; }
    .app-toast { display: flex; align-items: center; gap: 9px; position: fixed; bottom: 25px; left: calc(50% + 100px); transform: translateX(-50%); padding: 10px 14px; background: var(--plum-dark); color: white; border-radius: 8px; z-index: 80; font-size: 11px; box-shadow: 0 5px 20px #533f6340; }
    .app-toast .icon-button { color: #cebdd7; }
    .error-banner { display: flex; align-items: center; justify-content: space-between; gap: 15px; background: var(--error-bg); color: var(--error); padding: 12px 15px; border-radius: 7px; font-size: 11px; margin-bottom: 20px; }
