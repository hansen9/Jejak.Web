</style>
<div class="dashboard-app" id="app">
    <partial name="_SFDSidebar" />
    <div class="app-body">
        <partial name="_SFDTopbar" />
        <main class="dashboard-main">
            <section class="page-heading">
                <div>
                    <div class="eyebrow"><span></span> PANTAU. PAHAMI. ARAHKAN.</div>
                    <h1 id="page-title">Ringkasan hari ini</h1>
                    <p><span id="page-sub"></span> <span class="demo-tag" id="demo-tag">Data demo</span></p>
                </div>
                <div class="heading-actions">
                    <button class="icon-button refresh-button" id="btn-refresh" aria-label="Perbarui data">@Html.Icon("refresh-cw", 17)</button>
                    <label class="date-filter">
                        @Html.Icon("calendar-days", 17)
                        <input type="date" id="date-input" aria-label="Pilih tanggal perjalanan" />
                        @Html.Icon("chevron-down", 13)
                    </label>
                    <button class="button-primary" id="btn-export">@Html.Icon("download", 16)Unduh laporan</button>
                </div>
            </section>

            <div id="banners"></div>
            <section class="metrics" id="metrics" aria-label="Ringkasan indikator"></section>

            <section class="map-panel panel" id="map-panel">
                <div class="panel-heading map-panel-heading">
                    <div class="map-title"><h2>Pantauan tim</h2><span class="live-badge">@Html.Icon("radio", 12)<span id="live-badge-text">SIMULASI</span></span></div>
                    <div class="map-panel-actions">
                        <span class="last-update">Diperbarui <span id="updated-at">—</span></span>
                        <button class="icon-button" id="btn-expand" aria-label="Buka tampilan peta">@Html.Icon("expand", 16)</button>
                    </div>
                </div>
                <div class="map-toolbar">
                    <p><span class="status-dot"></span><span id="active-count">0</span> anggota aktif<span class="toolbar-separator">·</span><span>Perjalanan hari ini</span></p>
                    <div class="map-layer-options">
                        <label><input type="checkbox" id="toggle-traces" checked />Jejak perjalanan</label>
                        <label><input type="checkbox" id="toggle-remaining" checked />Jalur belum dilalui</label>
                    </div>
                </div>
                <div class="map-and-team">
                    <div class="map-canvas" id="map-canvas">
                        <div id="map-slot" class="leaflet-container-slot" aria-label="Peta posisi dan perjalanan tim"></div>
                        <div class="map-loading" id="map-loading">@Html.Icon("loader-circle", 24, 2, "spin")<span>Menyiapkan peta tim…</span></div>
                        <div class="map-location"><span class="status-dot"></span><strong id="map-place">Jakarta Selatan</strong><span id="map-region">DKI Jakarta</span></div>
                        <div class="map-controls">
                            <button id="map-zoom-in" aria-label="Perbesar peta">@Html.Icon("plus", 18)</button>
                            <button id="map-zoom-out" aria-label="Perkecil peta">@Html.Icon("minus", 18)</button>
                            <span></span>
                            <button id="map-fit" aria-label="Tampilkan seluruh tim">@Html.Icon("crosshair", 18)</button>
                            <button id="map-full" aria-label="Perluas peta">@Html.Icon("maximize-2", 17)</button>
                        </div>
                        <button class="map-style" id="map-style">@Html.Icon("layers", 16)<span>Detail jalan</span></button>
                        <div class="map-legend"><span><i class="legend-line"></i>Sudah dilalui</span><span><i class="legend-dashed"></i>Belum dilalui</span><span><i class="legend-dot"></i>Posisi anggota</span></div>
                        <div class="map-error" id="map-error" hidden>Peta dasar tidak tersedia. Jejak GPS tetap ditampilkan.</div>
                        <div class="map-empty" id="map-empty" hidden>Belum ada posisi untuk tanggal ini.</div>
                    </div>
                    <aside class="team-live">
                        <div class="team-live-heading">
                            <h3>Tim di lapangan <span id="team-count">0</span></h3>
                            <label class="status-filter" title="Filter status anggota">
                                @Html.Icon("sliders-horizontal", 16)
                                <select id="status-filter" aria-label="Filter status">
                                    <option value="all">Semua status</option>
                                    <option value="bergerak">Bergerak</option>
                                    <option value="berhenti">Berhenti</option>
                                    <option value="offline">Offline</option>
                                </select>
                            </label>
                        </div>
                        <label class="team-search">@Html.Icon("search", 15)<input id="team-search" placeholder="Cari anggota…" aria-label="Cari anggota tim di peta" /></label>
                        <div class="team-live-list" id="team-list"></div>
                        <div class="selected-member-detail" id="selected-detail" hidden></div>
                        <button class="team-all" data-view="team">Lihat semua anggota @Html.Icon("arrow-right", 15)</button>
                    </aside>
                </div>
            </section>

            <section class="panel report-panel" id="reports-panel">
                <div class="report-icon">@Html.Icon("file-chart-column", 35)</div>
                <div class="report-content">
                    <span class="eyebrow">LAPORAN OPERASIONAL</span>
                    <h2>Perjalanan hari ini, dalam satu laporan.</h2>
                    <p>Unduh rincian per anggota: wilayah, status, kecepatan, arah, jarak tempuh, dan GPS terakhir, beserta total rute dan jalur yang belum dilalui per wilayah. Berkas CSV dapat dibuka di Excel atau Google Sheets.</p>
                    <div class="report-facts" id="report-facts"></div>
                    <div class="report-buttons">
                        <button class="button-primary" id="btn-export-report">@Html.Icon("download", 16)<span id="report-download-label">Unduh CSV</span></button>
                        <button class="button-secondary" data-dialog="import">@Html.Icon("file-up", 16)Impor data GPS</button>
                    </div>
                    <p class="report-disclaimer">@Html.Icon("shield-check", 14)<span id="report-disclaimer"></span></p>
                </div>
            </section>

            <section class="panel member-table-panel" id="members-panel">
                <div class="panel-heading">
                    <div><h2>Performa tim</h2><p>Detail perjalanan dan kondisi anggota di lapangan.</p></div>
                    <button class="button-secondary" data-dialog="member">@Html.Icon("plus", 15)Tambah anggota</button>
                </div>
                <div class="table-scroll">
                    <table class="member-table">
                        <thead>
                            <tr>
                                <th>Anggota</th><th>Wilayah</th><th>Status</th><th>Kecepatan</th><th>Arah</th>
                                <th><button id="sort-distance">Jarak tempuh @Html.Icon("arrow-down-up", 12)</button></th>
                                <th>Daya GPS</th><th></th>
                            </tr>
                        </thead>
                        <tbody id="member-rows"></tbody>
                    </table>
                    <div class="table-empty" id="member-empty" hidden>
                        @Html.Icon("users", 25)
                        <h3>Belum ada anggota ditampilkan</h3>
                        <p>Tambahkan anggota atau sesuaikan filter Anda.</p>
                        <button class="button-secondary" data-dialog="member">@Html.Icon("plus", 15)Tambah anggota</button>
                    </div>
                </div>
                <button class="table-footer-button" id="member-all" data-view="team">Lihat semua <span id="member-all-count">0</span> anggota @Html.Icon("arrow-up-right", 14)</button>
            </section>

            <section class="panel routes-panel" id="routes-panel">
                <div class="panel-heading">
                    <div><h2>Cakupan per wilayah</h2><p>Jalur rencana dibandingkan dengan perjalanan yang tercatat.</p></div>
                    <button class="button-secondary" data-dialog="import">@Html.Icon("plus", 15)Impor rute</button>
                </div>
                <div class="table-scroll">
                    <table class="member-table routes-table">
                        <thead><tr><th>Wilayah &amp; rute</th><th>Total rute</th><th>Sudah dilalui</th><th>Belum dilalui</th><th>Cakupan</th><th></th></tr></thead>
                        <tbody id="route-rows"></tbody>
                    </table>
                    <div class="table-empty" id="route-empty" hidden>
                        @Html.Icon("route", 25)
                        <h3>Rute rencana belum tersedia</h3>
                        <p>Impor GeoJSON untuk mengukur wilayah yang belum dilalui.</p>
                        <button class="button-secondary" data-dialog="import">@Html.Icon("plus", 15)Impor rute</button>
                    </div>
                </div>
                <div class="route-note">Cakupan dihitung dari segmen rute dalam radius 50 meter dari jejak GPS. <span id="route-demo-note"></span></div>
            </section>

            <div class="demo-banner" id="demo-banner">
                <span class="demo-banner-icon">@Html.Icon("file-up", 19)</span>
                <div><strong>Siap melihat perjalanan tim Anda?</strong><p>Hubungkan GPS dan gunakan data lapangan yang sebenarnya.</p></div>
                <button data-dialog="account">Hubungkan tim @Html.Icon("chevron-right", 16)</button>
                <button class="icon-button" id="dismiss-demo" aria-label="Tutup informasi demo">@Html.Icon("x", 16)</button>
            </div>

            <footer class="dashboard-footer">
                <span>© 2026 Leader Dashboard. Setiap langkah berarti.</span>
                <div><span class="status-dot"></span><span id="footer-status"></span><i></i>Zona waktu WIB (UTC+7)</div>
            </footer>
        </main>
    </div>
    <partial name="_SFDDialogs" />
    <div class="app-toast" id="toast" role="status" hidden>
        @Html.Icon("check", 17)<span id="toast-text"></span>
        <button class="icon-button" id="toast-close" aria-label="Tutup pesan">@Html.Icon("x", 15)</button>
    </div>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script type="module" src="~/js/SFDDashboard.js" asp-append-version="true"></script>
}
