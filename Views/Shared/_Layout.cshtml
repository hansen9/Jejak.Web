@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var title = ViewData["Title"] as string ?? "Leader Dashboard";
    var description = ViewData["Description"] as string ?? "";
    var noIndex = ViewData["NoIndex"] is true;
    var canonical = SiteOrigin.From(Context.Request) + Context.Request.Path.Value;
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (description.Length > 0)
    {
        <meta name="description" content="@description" />
        <meta property="og:description" content="@description" />
        <meta name="twitter:description" content="@description" />
    }
    <meta property="og:title" content="@title" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@title" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@canonical" />
        <meta property="og:url" content="@canonical" />
    }
    <meta name="csrf-token" content="@csrf" />
    <link rel="icon" href="~/favicon.ico" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;450;500;550;600;650;700;750;800&display=swap" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="root">@RenderBody()</div>
    <script>
        window.SFD = @Json.Serialize(new { user = PagesController.CurrentUser(User), today = TrackingBuilder.Today(), colors = TrackingBuilder.MemberColors });
    </script>
    <script src="~/js/icons.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
