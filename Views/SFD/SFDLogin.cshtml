@{
    Layout = "_SFDLayout";
}
<style>
    .device-header { display: flex; align-items: center; justify-content: space-between; padding: 26px 40px; background: white; border-bottom: 1px solid var(--line); }
    .device-heading { text-align: center; margin-bottom: 28px; }
    .device-heading>.eyebrow { justify-content: center; }
    .device-heading h1 { font-size: 38px; letter-spacing: -1.5px; font-weight: 750; color: #684675; }
    .device-heading p { font-size: 11px; color: #ad8fbb; margin-top: 10px; }
    .device-footer { text-align: center; font-size: 9px; color: #b69ac4; margin-top: 20px; }
    .device-heading p { color: #96739f; }
    .device-footer { color: #9e81ac; }
    @@media (max-width: 760px) {
      .device-header { padding: 20px; }
      .device-header .brand { font-size: 27px; }
      .device-header .button-text { font-size: 9px; }
    }
    .login-page { min-height: 100dvh; background: #f7f3fa; }
    .login-main { max-width: 420px; margin: auto; padding: 56px 20px; }
    .login-card { padding: 27px; }
    .password-field { position: relative; display: block; }
    .password-field input { width: 100%; box-sizing: border-box; padding-right: 92px; }
    .password-toggle { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--plum); font-size: 10px; font-weight: 650; padding: 8px; border-radius: 6px; }
    .password-toggle:active:not(:disabled) { transform: translateY(-50%); }
    @@media (max-width: 640px) {
      .login-main { padding-top: 35px; }
      .login-card { padding: 22px; }
      .password-toggle { font-size: 12px; }
    }
</style>
<div class="login-page">
    <header class="device-header">
        <a class="brand" href="~/SFD"><span class="brand-symbol">@Html.Icon("route", 23)</span>Leader Dashboard</a>
        <a class="button-text" href="~/SFD">@Html.Icon("arrow-left", 16)Kembali ke dashboard</a>
    </header>
    <main class="login-main">
        <div class="device-heading">
            <span class="eyebrow">RUANG KERJA LEADER</span>
            <h1>Selamat datang.</h1>
            <p>Masuk untuk mengelola data tim lapangan Anda.</p>
        </div>
        <section class="panel login-card">
            <form class="app-form" id="login-form" data-return="@ViewBag.ReturnUrl" novalidate>
                <label>Username leader
                    <input name="username" type="text" required maxlength="254" placeholder="Username SoloFleet" autocomplete="username" autofocus />
                </label>
                <label>Kata sandi
                    <span class="password-field">
                        <input name="password" type="password" required placeholder="Masukkan kata sandi" autocomplete="current-password" />
                        <button class="password-toggle" type="button" id="password-toggle" aria-pressed="false">Tampilkan</button>
                    </span>
                </label>
                <p class="form-error" id="login-error" role="alert" hidden></p>
                <button class="button-primary wide" id="login-submit" type="submit">Masuk ke ruang kerja</button>
                <div class="info-box">@Html.Icon("lock-keyhole", 17)<p>Masuk dengan akun SoloFleet Anda. Hanya leader DMO yang dapat mengakses dashboard ini.</p></div>
            </form>
        </section>
        <p class="device-footer">Data tim hanya dapat diakses oleh akun pemilik.</p>
    </main>
</div>

@section Scripts {
    <script type="module" src="~/js/SFDLogin.js" asp-append-version="true"></script>
}
