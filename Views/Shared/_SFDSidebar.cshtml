@{
    (string Id, string Label, string Icon)[] items =
    [
        ("dashboard", "Ringkasan", "layout-dashboard"),
        ("map", "Peta langsung", "map"),
        ("team", "Anggota tim", "users"),
        ("routes", "Wilayah & rute", "route"),
        ("analytics", "Analitik", "chart-no-axes-combined"),
        ("reports", "Laporan", "file-chart-column"),
    ];
}
<style>
    .sidebar { position: fixed; width: 224px; height: 100dvh; left: 0; top: 0; background: var(--sidebar); border-right: 1px solid var(--line); padding: 33px 18px 0; display: flex; flex-direction: column; z-index: 30; }
    .brand-row { padding: 0 13px; }
    .brand-caption { color: #9b939e; font-size: 8px; font-weight: 650; letter-spacing: 1.5px; margin: 12px 0 33px 14px; }
    .workspace { display: flex; align-items: center; width: 100%; text-align: left; gap: 10px; padding: 12px 11px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); }
    .workspace:hover { background: var(--plum-light); }
    .workspace-icon { width: 33px; height: 35px; background: var(--plum-light); color: var(--plum); display: flex; align-items: center; justify-content: center; border-radius: 7px; }
    .workspace>span:nth-child(2) { flex: 1; }
    .workspace strong { font-size: 11.5px; font-weight: 750; display: block; }
    .workspace small { display: block; font-size: 10px; color: var(--subtle); margin-top: 3px; }
    .workspace>svg { color: var(--subtle); }
    .nav-caption { font-size: 9px; color: #a29aa9; letter-spacing: 1.5px; font-weight: 650; margin: 32px 0 12px 14px; }
    .sidebar nav { display: flex; flex-direction: column; gap: 5px; }
    .nav-item { position: relative; width: 100%; background: transparent; border: none; border-radius: 7px; min-height: 43px; display: flex; align-items: center; gap: 12px; padding: 10px 13px; color: #807686; font-size: 12px; text-align: left; font-weight: 550; }
    .nav-item:hover { color: var(--plum); background: #f5f1f7; }
    .nav-item.active { color: var(--plum); background: var(--plum-light); font-weight: 750; }
    .nav-item.active:before { content: ''; position: absolute; left: -18px; top: 12px; bottom: 12px; width: 3px; border-radius: 0 2px 2px 0; background: var(--plum); }
    .nav-chevron { margin-left: auto; }
    .nav-live { width: 5px; height: 5px; border-radius: 50%; background: var(--green); margin-left: auto; }
    .connection-note { display: flex; gap: 9px; align-items: flex-start; padding: 14px 13px; margin-bottom: 10px; border-top: 1px solid var(--line); }
    .connection-note .status-dot { margin-top: 4px; }
    .connection-note strong { font-size: 10px; font-weight: 650; display: block; }
    .connection-note small { font-size: 9px; display: block; color: var(--subtle); margin-top: 5px; }
    .profile-button { display: flex; align-items: center; width: calc(100% + 36px); margin: 15px -18px 0; padding: 18px 25px; border: none; border-top: 1px solid var(--line); background: transparent; gap: 10px; text-align: left; }
    .profile-button:hover { background: var(--plum-light); }
    .profile-avatar { width: 34px; height: 34px; border-radius: 50%; background: #eadfe8; color: #7a5c79; display: inline-flex; justify-content: center; align-items: center; font-size: 11px; font-weight: 750; flex-shrink: 0; border: 3px solid white; }
    .profile-button>span:nth-child(2) { flex: 1; min-width: 0; }
    .profile-button strong { display: block; font-size: 11px; max-width: 105px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .profile-button small { display: block; font-size: 9px; color: var(--subtle); margin-top: 3px; }
    .profile-button>svg { color: var(--subtle); }
    .mobile-bar, .mobile-close, .sidebar-scrim { display: none; }
    .app-body { margin-left: 224px; }
    .nav-item { font-size: 12.5px; }
    .workspace strong { font-size: 12px; }
    @@media (max-width: 1250px) {
      .sidebar { width: 205px; padding-left: 13px; padding-right: 13px; }
      .app-body { margin-left: 205px; }
      .nav-item.active:before { left: -13px; }
      .profile-button { width: calc(100% + 26px); margin-left: -13px; margin-right: -13px; }
    }
    @@media (max-width: 1020px) {
      .sidebar { width: 184px; padding-left: 11px; padding-right: 11px; }
      .app-body { margin-left: 184px; }
      .brand-caption { font-size: 6.5px; letter-spacing: 1.3px; }
      .nav-item { font-size: 10.5px; gap: 10px; padding-left: 11px; padding-right: 11px; }
      .nav-item.active:before { left: -11px; }
      .workspace { padding: 11px 8px; gap: 7px; }
      .workspace strong { font-size: 10px; }
      .workspace small { font-size: 8px; }
      .profile-button { width: calc(100% + 22px); margin-left: -11px; margin-right: -11px; padding-left: 19px; padding-right: 19px; }
      .profile-button strong { font-size: 10px; }
      .connection-note { padding-left: 11px; }
      .connection-note strong { font-size: 9px; }
      .connection-note small { font-size: 8px; }
    }
    @@media (max-width: 760px) {
      .sidebar { transform: translateX(-100%); width: 230px; padding: 26px 18px 0; transition: transform .22s ease-out; z-index: 50; }
      .sidebar.is-open { transform: translateX(0); }
      .sidebar-scrim { display: block; position: fixed; inset: 0; background: #302a3855; border: none; z-index: 40; }
      .mobile-bar { display: flex; align-items: center; justify-content: space-between; background: white; height: 67px; border-bottom: 1px solid var(--line); padding: 0 20px; }
      .mobile-bar .brand { font-size: 28px; }
      .mobile-bar .icon-button { width: 44px; height: 44px; }
      .mobile-close { display: inline-flex; }
      .brand-row { display: flex; justify-content: space-between; align-items: center; padding: 0 10px; }
      .brand-caption { font-size: 8px; letter-spacing: 1.5px; }
      .nav-item { min-height: 45px; font-size: 12px; padding-left: 13px; padding-right: 13px; }
      .nav-item.active:before { left: -18px; }
      .workspace { padding: 12px; }
      .workspace strong { font-size: 12px; }
      .workspace small { font-size: 10px; }
      .connection-note strong { font-size: 10px; }
      .connection-note small { font-size: 9px; }
      .profile-button { margin-left: -18px; margin-right: -18px; width: calc(100% + 36px); }
      .app-body { margin-left: 0; }
    }
    .nav-item:not(.active) .nav-chevron { display: none; }
    .brand-row { display: flex; justify-content: space-between; align-items: center; }
    .sidebar-toggle svg { transition: transform .2s; }
    .sidebar, .app-body { transition: width .2s ease, margin-left .2s ease; }
    @@media (min-width: 761px) {
      body.sidebar-collapsed .sidebar { width: 68px; padding-left: 10px; padding-right: 10px; overflow: hidden; }
      body.sidebar-collapsed .app-body { margin-left: 68px; }
      body.sidebar-collapsed .brand-row { justify-content: center; padding: 0; }
      body.sidebar-collapsed .brand-row .brand, body.sidebar-collapsed .brand-caption, body.sidebar-collapsed .nav-caption, body.sidebar-collapsed .nav-item span, body.sidebar-collapsed .nav-chevron, body.sidebar-collapsed .workspace>span:nth-child(2), body.sidebar-collapsed .workspace>svg, body.sidebar-collapsed .connection-note>div, body.sidebar-collapsed .profile-button>span:nth-child(2), body.sidebar-collapsed .profile-button>svg { display: none; }
      body.sidebar-collapsed .sidebar-toggle svg { transform: rotate(180deg); }
      body.sidebar-collapsed .brand-caption { margin: 0; }
      body.sidebar-collapsed .workspace { justify-content: center; padding: 8px 0; }
      body.sidebar-collapsed .nav-item { justify-content: center; padding-left: 0; padding-right: 0; }
      body.sidebar-collapsed .nav-item.active:before { left: -10px; }
      body.sidebar-collapsed .nav-live { position: absolute; top: 9px; right: 9px; margin: 0; }
      body.sidebar-collapsed .connection-note { justify-content: center; padding-left: 0; padding-right: 0; }
      body.sidebar-collapsed .profile-button { justify-content: center; width: calc(100% + 20px); margin-left: -10px; margin-right: -10px; padding: 14px 0; }
      body.sidebar-collapsed .nav-caption { margin: 18px 0 0; height: 0; }
    }
</style>
<div class="mobile-bar">
    <a class="brand" href="/"><span class="brand-symbol">@Html.Icon("route", 23)</span>Leader Dashboard</a>
    <button class="icon-button" id="nav-open" aria-label="Buka navigasi">@Html.Icon("menu", 22)</button>
</div>
<div id="nav-scrim-slot"></div>
<aside class="sidebar" id="sidebar">
    <div class="brand-row">
        <a class="brand" href="/"><span class="brand-symbol">@Html.Icon("route", 23, 2.1)</span><span class="brand-text">Leader Dashboard</span></a>
        <button class="sidebar-toggle icon-button" id="nav-close" aria-label="Ciutkan navigasi" title="Ciutkan navigasi">@Html.Icon("arrow-left", 20)</button>
    </div>
    <div class="brand-caption">SETIAP LANGKAH TERLIHAT.</div>
    <button class="workspace" data-dialog="account">
        <span class="workspace-icon">@Html.Icon("users", 19)</span>
        <span><strong>Tim Lapangan</strong><small>Jakarta Selatan</small></span>
        @Html.Icon("chevron-down", 15)
    </button>
    <div class="nav-caption">RUANG KERJA</div>
    <nav aria-label="Navigasi utama">
        @foreach (var item in items)
        {
            <button class="nav-item" data-nav="@item.Id" data-label="@item.Label">
                @Html.Icon(item.Icon, 20, 1.7)<span>@item.Label</span>
                @if (item.Id == "map") { <span class="nav-live"></span> }
                @Html.Icon("chevron-right", 15, 2, "nav-chevron")
            </button>
        }
    </nav>
    <div class="sidebar-bottom">
        <div class="connection-note">
            <span class="status-dot copper" id="conn-dot"></span>
            <div><strong id="conn-title">Mode demonstrasi</strong><small id="conn-sub">Jelajahi dengan data contoh</small></div>
        </div>
        <button class="nav-item" data-dialog="account">@Html.Icon("settings-2", 19, 1.7)<span>Pengaturan</span></button>
        <button class="nav-item" data-dialog="help">@Html.Icon("circle-help", 19, 1.7)<span>Bantuan &amp; panduan</span></button>
        <button class="profile-button" data-dialog="account">
            <span class="profile-avatar" id="side-avatar">RL</span>
            <span><strong id="side-name">Ruang Leader</strong><small id="side-sub">Pratinjau dashboard</small></span>
            @Html.Icon("chevron-down", 15)
        </button>
    </div>
</aside>
